[Unit]
Description=ProofCell control plane
After=docker.service network-online.target
Requires=docker.service

[Service]
WorkingDirectory=/root/proofcell
EnvironmentFile=/root/proofcell/.env
ExecStart=/root/proofcell/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
